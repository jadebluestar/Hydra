# ──────────────────────────────────────────────
# Hydra — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ──────────────────────────────────────────────

# Application
APP_NAME=hydra
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local dev:  postgresql+asyncpg://hydra:hydra_secret@localhost:5432/hydra
# In Docker:  postgresql+asyncpg://hydra:hydra_secret@postgres:5432/hydra
DATABASE_URL=postgresql+asyncpg://hydra:hydra_secret@localhost:5432/hydra
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
# Local dev:  redis://localhost:6379/0
# In Docker:  redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# JWT — generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
